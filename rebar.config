{minimum_otp_vsn, "24.0"}.

{cover_enabled, false}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    {src_dirs, ["src", "priv/tracers"]},
    {i, "_build/default/plugins/gpb/include"},
    %% ToDo: Clean these out
    {d, namespaced_types},
    {d, set_env_options}
    %% No longer relevant, here for eventual cleanup
    % {platform_define, "^R15", old_hash}
]}.

{erl_first_files, [
    "src/riak_kv_backend.erl"
]}.

{src_dirs, [
    "priv/tracers",
    "src"
]}.

{edoc_opts, [
    {preprocess, true},
    {includes, ["include", "_build/default/plugins/gpb/include"]},
    {report_missing_types, true}
]}.

{eunit_opts, [verbose, {report, {eunit_progress, [colored, profile]}}]}.

{xref_checks, [
    deprecated_function_calls,
    deprecated_functions,
    locals_not_used,
    undefined_function_calls,
    undefined_functions
]}.

{xref_ignores, [
    riak_core_pb,   % Generated file
    gen_fsm         % Yeah, some day ...
]}.

{plugins, [
    {rebar3_gpb_plugin,
        {git, "https://github.com/OpenRiak/rebar3_gpb_plugin.git",
            {branch, "wday-develop-3.2"}}},
    {eqc_rebar,
        {git, "https://github.com/Quviq/eqc-rebar",
            {branch, "master"}}}
]}.

{gpb_opts, [
    {module_name_suffix, "_pb"},
    {i, "src"}
]}.

{dialyzer, [
    {plt_apps, all_deps},
    {warnings, [
        % error_handling,
        % unknown,
        % unmatched_returns
    ]}
]}.

{provider_hooks, [
    {pre, [{compile, {protobuf, compile}}]}
]}.

{profiles, [
    {eqc, [
        %% Profile for EQC/PULSE compilation, xref, and dialyzer checks.
        %% The QuickCheck and Pulse applications must be installed in the OTP
        %% 'lib' tree to use this, but don't need to be started.
        %% Note that the QuickCheck and Pulse applications cannot be added to
        %% the PLT with '{plt_extra_apps, [eqc, pulse]}' because their BEAM
        %% files are stripped.
        {deps, [
            {meck,
                {git, "https://github.com/OpenRiak/meck.git",
                    {branch, "wday-develop-3.2"}}}
        ]},
        {erl_opts, [
            {src_dirs, ["src", "priv/tracers", "eqc"]},
            {d, 'EQC'}, {d, 'PULSE'}, {d, 'TEST'}
        ]}
    ]},
    {gha, [
        {erl_opts, [
            {d, 'GITHUBEXCLUDE'}
        ]}
    ]},
    {test, [
        {deps, [
            {meck,
                {git, "https://github.com/OpenRiak/meck.git",
                    {branch, "wday-develop-3.2"}}}
        ]}
    ]}
]}.

{deps, [
    {riak_core,
        {git, "https://github.com/OpenRiak/riak_core.git",
            {branch, "wday-develop-3.2"}}},
    {sidejob,
        {git, "https://github.com/OpenRiak/sidejob.git",
            {branch, "wday-develop-3.2"}}},
    {bitcask,
        {git, "https://github.com/OpenRiak/bitcask.git",
            {branch, "wday-develop-3.2"}}},
    {redbug,
        {git, "https://github.com/OpenRiak/redbug.git",
            {branch, "wday-develop-3.2"}}},
    {recon,
        {git, "https://github.com/OpenRiak/recon.git",
            {branch, "wday-develop-3.2"}}},
    {sext,
        {git, "https://github.com/OpenRiak/sext.git",
            {branch, "wday-develop-3.2"}}},
    {riak_pipe,
        {git, "https://github.com/OpenRiak/riak_pipe.git",
            {branch, "wday-develop-3.2"}}},
    {riak_dt,
        {git, "https://github.com/OpenRiak/riak_dt.git",
            {branch, "wday-develop-3.2"}}},
    {riak_api,
        {git, "https://github.com/OpenRiak/riak_api.git",
            {branch, "wday-develop-3.2"}}},
    {hyper,
        {git, "https://github.com/OpenRiak/hyper.git",
            {branch, "wday-develop-3.2"}}},
    {kv_index_tictactree,
        {git, "https://github.com/OpenRiak/kv_index_tictactree.git",
            {branch, "wday-develop-3.2"}}},
    {rhc,
        {git, "https://github.com/OpenRiak/riak-erlang-http-client.git",
            {branch, "wday-develop-3.2"}}}
]}.
