{minimum_otp_vsn, "26.0"}.

{cover_enabled, false}.

{erl_opts, [
    debug_info,
    warnings_as_errors,
    {src_dirs, ["src"]},
    {i, "_build/default/plugins/gpb/include"},
    %% ToDo: Clean these out
    {d, namespaced_types},
    {d, set_env_options}
    %% No longer relevant, here for eventual cleanup
    % {platform_define, "^R15", old_hash}
]}.

{erl_first_files, [
    "src/riak_kv_backend.erl"
]}.

{src_dirs, [
    "priv/tracers",
    "src"
]}.

{edoc_opts, [
    {preprocess, true},
    {includes, ["include", "_build/default/plugins/gpb/include"]},
    {report_missing_types, true}
]}.

{erlfmt, [
    write,
    {print_width, 80},
    {files, [
        "include/riak_kv_web.hrl",
        "src/riak_kv_web_bucketlist.erl",
        "src/riak_kv_web_keylist.erl",
        "src/riak_kv_web_object_read.erl",
        "src/riak_kv_web_object_store.erl",
        "src/riak_kv_web_object_delete.erl",
        "src/riak_kv_web_stats.erl",
        "src/riak_kv_web_index.erl",
        "src/riak_kv_web_aaefold.erl",
        "src/riak_kv_web_queue.erl",
        "src/riak_kv_web_query.erl",
        "src/riak_kv_web_common.erl",
        "src/riak_kv_web_bprops.erl",
        "rebar.config"
    ]},
    {exclude_files, []}
]}.

{eunit_opts, [verbose, {report, {eunit_progress, [colored, profile]}}]}.

{xref_checks, [
    deprecated_function_calls,
    deprecated_functions,
    locals_not_used,
    undefined_function_calls,
    undefined_functions
]}.

{xref_ignores, [
    % Generated file
    riak_core_pb,
    % Yeah, some day ...
    gen_fsm
]}.

{project_plugins, [
    {erlfmt, {git, "https://github.com/OpenRiak/erlfmt.git", {branch, "main"}}}
]}.

{erl_first_files, ["src/riak_kv_backend.erl"]}.

{plugins, [
    {rebar3_gpb_plugin,
        {git, "https://github.com/OpenRiak/rebar3_gpb_plugin",
            {branch, "openriak-3.4"}}},
    {eqc_rebar, {git, "https://github.com/Quviq/eqc-rebar", {branch, "master"}}}
]}.

{gpb_opts, [{module_name_suffix, "_pb"}, {i, "src"}]}.

{dialyzer, [
    {plt_apps, all_deps},
    {warnings, [
        % error_handling,
        % unknown,
        % unmatched_returns
    ]}
]}.

{provider_hooks, [{pre, [{compile, {protobuf, compile}}]}]}.

{profiles, [
    {test, [
        {deps, [
            {meck,
                {git, "https://github.com/OpenRiak/meck.git",
                    {branch, "openriak-3.4"}}}
        ]}
    ]},
    {eqc, [
        {deps, [
            {meck,
                {git, "https://github.com/OpenRiak/meck.git",
                    {branch, "openriak-3.4"}}}
        ]},
        {extra_src_dirs, ["eqc"]}
    ]},
    {gha, [{erl_opts, [{d, 'GITHUBEXCLUDE'}]}]}
]}.

{deps, [
    {riak_core,
        {git, "https://github.com/OpenRiak/riak_core.git",
            {branch, "openriak-4.0"}}},
    {sidejob,
        {git, "https://github.com/OpenRiak/sidejob.git",
            {branch, "openriak-3.4"}}},
    {bitcask,
        {git, "https://github.com/OpenRiak/bitcask.git",
            {branch, "openriak-3.4"}}},
    {redbug,
        {git, "https://github.com/OpenRiak/redbug", {branch, "openriak-3.4"}}},
    {recon,
        {git, "https://github.com/OpenRiak/recon", {branch, "openriak-3.4"}}},
    {sext,
        {git, "https://github.com/OpenRiak/sext.git", {branch, "openriak-3.4"}}},
    {riak_dt,
        {git, "https://github.com/OpenRiak/riak_dt.git",
            {branch, "openriak-3.4"}}},
    {riak_pb,
        {git, "https://github.com/OpenRiak/riak_pb.git",
            {branch, "openriak-3.4"}}},
    {riak_api,
        {git, "https://github.com/OpenRiak/riak_api.git",
            {branch, "nhse-o40-orkv.i141-silvermachine"}}},
    {kv_index_tictactree,
        {git, "https://github.com/OpenRiak/kv_index_tictactree.git",
            {branch, "openriak-4.0"}}},
    {rhc,
        {git, "https://github.com/OpenRiak/riak-erlang-http-client",
            {branch, "openriak-4.0"}}}
]}.
